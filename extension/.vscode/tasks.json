// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build ThoughtPath",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-p", "${workspaceFolder}"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$tsc",
			"presentation": {
				"reveal": "silent"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
